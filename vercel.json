{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hbinfinite.nl"
        }
      ],
      "destination": "https://www.hbinfinite.nl/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hbinfinite.nl"
        }
      ],
      "destination": "https://www.hbinfinite.nl/:path*",
      "permanent": true
    }
  ]
}
